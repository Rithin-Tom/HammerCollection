<div class="container my-4">

  <h2 class="mb-4">Return Requests Management</h2>

  <!-- Filter Section -->
  <div class="d-flex justify-content-between align-items-center mb-3">

  <!-- Search -->
  <form method="GET" action="/admin/productReturn" class="d-flex gap-2">

    <input
      type="text"
      name="search"
      class="form-control"
      placeholder="Search Order ID or Customer"
      value="<%= search || '' %>"
    >

    <!-- Status Filter -->
    <select name="status" class="form-select">
      <option value="">All Status</option>
      <option value="Pending" <%= selectedStatus==='Pending'?'selected':'' %>>Pending</option>
      <option value="Approved" <%= selectedStatus==='Approved'?'selected':'' %>>Approved</option>
      <option value="Rejected" <%= selectedStatus==='Rejected'?'selected':'' %>>Rejected</option>
    </select>

    <button class="btn btn-dark">Search</button>

    <a href="/admin/productReturn" class="btn btn-secondary">Clear</a>

  </form>

</div>
  <!-- Table -->
 <div class="table-responsive shadow rounded">

<table class="table table-hover align-middle">

<thead class="table-dark">
<tr>
<th>#</th>
<th>Order ID</th>
<th>Customer</th>
<th>Return Reason</th>
<th>Status</th>
<th>Date</th>
<th>Action</th>
</tr>
</thead>

<tbody>

<% if(returns.length > 0){ %>

<% returns.forEach((item,index)=>{ %>

<tr>

<td><%= index+1 %></td>

<td>#<%= item.orderId %></td>

<td><%= item.address.name %></td>

<td><%= item.returnRequest.reason %></td>

<td>

<% if(item.orderStatus === "ReturnRequested"){ %>
<span class="badge bg-warning text-dark">Pending</span>
<% } %>

<% if(item.orderStatus === "Returned"){ %>
<span class="badge bg-success">Approved</span>
<% } %>

<% if(item.orderStatus === "ReturnRejected"){ %>
<span class="badge bg-danger">Rejected</span>
<% } %>

</td>

<td>
<%= new Date(item.createdOn).toLocaleDateString('en-IN') %>
</td>

<td>

<button 
class="btn btn-sm btn-primary view-return"
data-bs-toggle="modal"
data-bs-target="#returnModal"

data-orderid="<%= item.orderId %>"
data-customer="<%= item.address.name %>"
data-reason="<%= item.returnRequest.reason %>"
data-product="<%= item.orderedItems[0].name %>"
data-price="<%= item.orderedItems[0].price %>"
data-qty="<%= item.orderedItems[0].quantity %>"
data-id="<%= item._id %>"
>

Verify

</button>

</td>

</tr>

<% }) %>

<% } else { %>

<tr>
<td colspan="7" class="text-center text-muted">
No Return Requests
</td>
</tr>

<% } %>

</tbody>

</table>
</div>

<div class="modal fade" id="returnModal" tabindex="-1">

<div class="modal-dialog modal-lg">

<div class="modal-content">

<div class="modal-header">
<h5 class="modal-title">Verify Return Request</h5>
<button class="btn-close" data-bs-dismiss="modal"></button>
</div>

<div class="modal-body">

<div class="row">

<div class="col-md-6">

<h6>Order Info</h6>

<p><strong>Order ID:</strong> <span id="modalOrderId"></span></p>

<p><strong>Customer:</strong> <span id="modalCustomer"></span></p>

</div>

<div class="col-md-6">

<h6>Product Details</h6>

<p><strong>Product:</strong> <span id="modalProduct"></span></p>

<p><strong>Price:</strong> ₹<span id="modalPrice"></span></p>

<p><strong>Quantity:</strong> <span id="modalQty"></span></p>

</div>

</div>

<hr>

<h6>Return Reason</h6>

<p id="modalReason" class="text-danger"></p>

</div>

<div class="modal-footer">

<button id="approveBtn" class="btn btn-success">
Approve Return
</button>

<button id="rejectBtn" class="btn btn-danger">
Reject Return
</button>

</div>

</div>

</div>

</div>

  <!-- Pagination -->
  <div class="d-flex justify-content-center mt-4">
    <nav>
      <ul class="pagination">

        <!-- Previous -->
        <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
          <a class="page-link"
            href="/admin/returns?page=<%= currentPage - 1 %>&status=<%= selectedStatus || '' %>">
            Previous
          </a>
        </li>

        <!-- Page Numbers -->
        <% for (let i = 1; i <= totalPages; i++) { %>
          <li class="page-item <%= currentPage === i ? 'active' : '' %>">
            <a class="page-link"
              href="/admin/returns?page=<%= i %>&status=<%= selectedStatus || '' %>">
              <%= i %>
            </a>
          </li>
        <% } %>

        <!-- Next -->
        <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
          <a class="page-link"
            href="/admin/returns?page=<%= currentPage + 1 %>&status=<%= selectedStatus || '' %>">
            Next
          </a>
        </li>

      </ul>
    </nav>
  </div>

</div>

<script>

let selectedOrderId = null;

document.querySelectorAll(".view-return").forEach(btn => {

btn.addEventListener("click", function(){

document.getElementById("modalOrderId").innerText = this.dataset.orderid;
document.getElementById("modalCustomer").innerText = this.dataset.customer;
document.getElementById("modalProduct").innerText = this.dataset.product;
document.getElementById("modalPrice").innerText = this.dataset.price;
document.getElementById("modalQty").innerText = this.dataset.qty;
document.getElementById("modalReason").innerText = this.dataset.reason;

selectedOrderId = this.dataset.id;

});

});

</script>
<script>

document.getElementById("approveBtn").addEventListener("click", async () => {

const res = await fetch(`/admin/return/approve/${selectedOrderId}`,{
method:"PUT"
})

const data = await res.json()

if(data.success){
Swal.fire("Approved","Return approved","success")
location.reload()
}

})

document.getElementById("rejectBtn").addEventListener("click", async () => {

const res = await fetch(`/admin/return/reject/${selectedOrderId}`,{
method:"PUT"
})

const data = await res.json()

if(data.success){
Swal.fire("Rejected","Return rejected","success")
location.reload()
}

})

</script>